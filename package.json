{
  "name": "memoryledger-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "db:generate": "npm --workspace @memoryledger/db run generate",
    "db:migrate": "npm --workspace @memoryledger/db run migrate",
    "db:push": "npm --workspace @memoryledger/db run push"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "engines": {"node": ">=22"}
}
